# ==============================================================================
# Collecte École PWA — Variables d'environnement
# ==============================================================================

# --- Serveur, Port & Sécurité ---
NODE_ENV=development
PORT=4000
APP_PORT=3040
APP_BASE_URL=http://localhost:5173
CORS_ORIGIN=*

# Secret JWT (OBLIGATOIRE en production : au moins 32 caractères aléatoires)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Compte SuperAdmin initial (créé automatiquement au premier démarrage)
SUPERADMIN_EMAIL=denis.safieddine@gmail.com
SUPERADMIN_PASSWORD=ChangeMe2026!
SUPERADMIN_NAME=Denis Safieddine

# --- Base de données ---
# Démarrage local rapide (SQLite) :
DATABASE_URL=file:./dev.db
# Production Docker / PostgreSQL (utilisé par docker-compose.yml) :
# DATABASE_URL=postgresql://collecte:collecte_secret@postgres:5432/collecte_ecole?schema=public

# Identifiants PostgreSQL pour docker-compose.yml
POSTGRES_USER=collecte
POSTGRES_PASSWORD=collecte_secret
POSTGRES_DB=collecte_ecole

# --- Géocodage (Architecture modulaire : photon | mapbox | google) ---
GEOCODING_PROVIDER=photon
PHOTON_BASE_URL=https://photon.komoot.io

# Clés optionnelles si vous basculez vers Mapbox ou Google Places
MAPBOX_ACCESS_TOKEN=
GOOGLE_PLACES_API_KEY=

# --- Courriels (Nodemailer SMTP - Brevo, Gmail, Postmark, etc.) ---
# Exemple Brevo  : SMTP_HOST=smtp-relay.brevo.com | SMTP_PORT=587 | SMTP_SECURE=false
# Exemple Gmail  : SMTP_HOST=smtp.gmail.com       | SMTP_PORT=465 | SMTP_SECURE=true (mot de passe d'application)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Collecte École
SMTP_FROM_EMAIL=collecte@ecole.local

# En mode simulation (true), aucun courriel réel n'est envoyé : les liens terrain sont retournés dans l'admin.
# Passez à false une fois votre serveur SMTP configuré.
SMTP_DRY_RUN=true

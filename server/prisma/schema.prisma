generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  users     User[]
  campaigns Campaign[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         String   @default("TENANT_ADMIN")
  tenantId     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Campaign {
  id                  String          @id @default(cuid())
  tenantId            String
  name                String
  city                String
  centerLat           Float
  centerLng           Float
  zoomLevel           Int             @default(13)
  boundaryGeoJson     String?
  isDonorFormOpen     Boolean         @default(true)
  isVolunteerFormOpen Boolean         @default(true)
  lastPurgedAt        DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sectors             Sector[]
  volunteers          Volunteer[]
  donationPoints      DonationPoint[]

  @@index([tenantId])
}

model Sector {
  id             String          @id @default(cuid())
  campaignId     String
  name           String
  color          String
  geoJsonPolygon String
  accessToken    String          @unique @default(uuid())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  campaign       Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  volunteers     Volunteer[]
  donationPoints DonationPoint[]

  @@index([campaignId])
}

model Volunteer {
  id             String    @id @default(cuid())
  campaignId     String
  sectorId       String?
  fullName       String
  email          String
  phone          String
  notes          String?
  isAnonymized   Boolean   @default(false)
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())

  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sector         Sector?   @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([sectorId])
}

model DonationPoint {
  id                String    @id @default(cuid())
  campaignId        String
  sectorId          String?
  address           String
  lat               Float
  lng               Float
  donorName         String?
  instructions      String?
  preferredTimeSlot String?
  status            String    @default("PENDING")
  isAnonymized      Boolean   @default(false)
  updatedAt         DateTime  @updatedAt
  createdAt         DateTime  @default(now())

  campaign          Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sector            Sector?   @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([sectorId])
  @@index([status])
}
